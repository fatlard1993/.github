#!/usr/bin/env bash
# Build a mod of the suite as it is pushed, and release it on GitHub as v<mod_version>.
#
#   mod-release MOD            from the directory holding the MOD checkout
#   mod-release --dry-run MOD  build it, released or not, and say what would be released
#
# A mod whose version is released but whose shipped files changed since is bumped first: the patch
# number goes up, the subjects of the commits since become its changelog entry, and the bump is
# committed and pushed before the build, so the release is of a commit that says its version. A
# minor or major bump stays a person's decision; one pushed by hand is released as it is.
#
# A mod builds against sibling checkouts beside it (../pandorical, and the built jars of the ones
# whose API it compiles against), so those are cloned next to it first, and built in the order
# their jars are needed. ender-index reads release jars and nothing else; the release carries the
# one jar named by the version, never a sources or testsupport jar.
set -euo pipefail

OWNER=fatlard1993

# What a release carries: everything but the repository's own workflows and its prose.
SHIPPED=(. ':(exclude).github' ':(exclude)*.md' ':(exclude)LICENSE')
dry=0
[[ "${1:-}" == "--dry-run" ]] && { dry=1; shift; }
mod="${1:?which mod}"

prop() { sed -nE "s/^$2 *= *//p" "$1/gradle.properties" | tr -d '[:space:]'; }

version=$(prop "$mod" mod_version)
tag="v$version"

changelog_of() {
	local resources
	for resources in "$1"/src/main/resources "$1"/src/client/resources; do
		[[ -f "$resources/pandorical.changelog.json" ]] && { echo "$resources/pandorical.changelog.json"; return; }
	done
}

if gh release view "$tag" -R "$OWNER/$mod" > /dev/null 2>&1; then
	git -C "$mod" fetch -q --tags origin 2>/dev/null || true

	if ! git -C "$mod" rev-parse -q --verify "refs/tags/$tag" > /dev/null; then
		echo "$mod: $tag is released, but its tag is not here to compare against" >&2
		exit 1
	fi

	if git -C "$mod" diff --quiet "$tag" HEAD -- "${SHIPPED[@]}"; then
		echo "$mod: $tag is released, and nothing shipped has changed since"
		((dry)) || exit 0
	else
		bumped="${version%.*}.$((${version##*.} + 1))"
		mapfile -t subjects < <(git -C "$mod" log --reverse --format=%s "$tag"..HEAD -- "${SHIPPED[@]}")
		mapfile -t lines < <(printf '%s\n' "${subjects[@]}" | sed -E 's/^(.)/\U\1/; s/([^.!?])$/\1./')

		echo "$mod: $tag is released, and ${#subjects[@]} change(s) since, so it becomes v$bumped"

		sed -i -E "s/^(mod_version *= *).*/\1$bumped/" "$mod/gradle.properties"

		changelog=$(changelog_of "$mod")
		if [[ -n "$changelog" ]]; then
			indent=(); grep -q $'^\t' "$changelog" && indent=(--tab)
			jq "${indent[@]}" --arg v "$bumped" '.versions = ({($v): $ARGS.positional} + .versions)' \
				--args "${lines[@]}" < "$changelog" > "$changelog.next" && mv "$changelog.next" "$changelog"
		fi

		version=$bumped
		tag="v$version"

		if ((!dry)); then
			git -C "$mod" -c user.name='github-actions[bot]' -c user.email='41898282+github-actions[bot]@users.noreply.github.com' \
				commit -qam "$version: ${subjects[0],}"
			git -C "$mod" push -q origin HEAD
		fi
	fi
fi

siblings_of() { grep -ohE '\.\./[a-z0-9-]+' "$1"/*.gradle 2>/dev/null | sed 's|^\.\./||' | sort -u; }
# A provider is a sibling whose jar this one's build needs: named by its gradle.properties, or by
# the dependent.gradle a mod applies to compile against it.
providers_of() { grep -ohE '\.\./[a-z0-9-]+/(gradle\.properties|gradle/dependent\.gradle)' "$1/build.gradle" 2>/dev/null | sed -E 's|^\.\./([a-z0-9-]+)/.*|\1|' | sort -u; }

declare -A have=(["$mod"]=1)
queue=("$mod")
while ((${#queue[@]} > 0)); do
	repo="${queue[0]}"
	queue=("${queue[@]:1}")
	for sibling in $(siblings_of "$repo"); do
		[[ -n "${have[$sibling]:-}" ]] && continue
		have["$sibling"]=1
		[[ -d "$sibling" ]] || git clone -q --depth 1 "https://github.com/$OWNER/$sibling.git" "$sibling"
		queue+=("$sibling")
	done
done

# A sibling a build takes in as a subproject of its own, by settings.gradle: its providers are this
# build's too, since it is compiled here.
included_of() { grep -ohE "'\.\./[a-z0-9-]+'" "$1/settings.gradle" 2>/dev/null | tr -d "'" | sed 's|^\.\./||' | sort -u; }
needs_of() { { providers_of "$1"; for included in $(included_of "$1"); do providers_of "$included"; done; } | sort -u; }

declare -A built=()
build() {
	local repo="$1"
	[[ -n "${built[$repo]:-}" ]] && return 0
	built["$repo"]=1
	for provider in $(needs_of "$repo"); do build "$provider"; done
	echo "building $repo"
	(cd "$repo" && rm -f build/libs/*.jar && ./gradlew build -q)
}
build "$mod"

jar=$(find "$mod/build/libs" -maxdepth 1 -name "*-$version.jar" ! -name '*-sources.jar' ! -name '*-testsupport.jar' | head -1)
[[ -n "$jar" ]] || { echo "$mod: the build made no jar for $version" >&2; exit 1; }

for resources in "$mod"/src/main/resources "$mod"/src/client/resources; do
	[[ -f "$resources/fabric.mod.json" ]] && break
done
name=$(jq -r '.name // empty' "$resources/fabric.mod.json" 2>/dev/null || true)
head=$(git -C "$mod" rev-parse HEAD)
notes=$(jq -r --arg v "$version" '.versions[$v] // [] | map("- " + .) | join("\n")' "$resources/pandorical.changelog.json" 2>/dev/null || true)
[[ -n "$notes" ]] || notes="Built from ${head:0:12}."

if ((dry)); then
	echo "$mod: would release $tag with $(basename "$jar")"
	echo "$notes"
	exit 0
fi

gh release create "$tag" "$jar" -R "$OWNER/$mod" --target "$head" --title "${name:-$mod} $version" --notes "$notes"
